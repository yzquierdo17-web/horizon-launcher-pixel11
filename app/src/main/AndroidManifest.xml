<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Next meeting under the clock (asked for at runtime, optional) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Icon packs (Nova / ADW / GO / Lawnchair formats) -->
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="app.lawnchair.icons.THEMED_ICON" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Horizon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Horizon Dial" live wallpaper: the rotating dial clock for the lock screen -->
        <service
            android:name=".DialWallpaperService"
            android:exported="true"
            android:label="@string/dial_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/dial_wallpaper" />
        </service>

        <!-- Dynamic Island: reads calls, timers, music and new notifications (once you allow access) -->
        <service
            android:name=".IslandListener"
            android:exported="true"
            android:label="@string/island_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Dynamic Island over every app and the lock screen. Only draws the island; reads nothing on screen. -->
        <service
            android:name=".IslandOverlayService"
            android:exported="false"
            android:label="@string/island_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/island_accessibility" />
        </service>
    </application>
</manifest>
